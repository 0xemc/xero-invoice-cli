# Xero API Credentials
# Get these from https://developer.xero.com/myapps
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
REDIRECT_URI=http://localhost:3000/callback

# Xero API Scopes
SCOPES=openid profile email accounting.transactions accounting.settings accounting.contacts offline_access

# Local server for OAuth callback
PORT=3000

# Google Calendar - set to true to force re-auth on every request
REQUIRE_GCAL_REAUTH=false
# Google Calendar - set to true for headless/server environments
GCAL_HEADLESS=false
