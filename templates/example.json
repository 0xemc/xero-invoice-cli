{
  "name": "Example Invoice Template",
  "description": "Generic example invoice template. Copy and customize this file instead of editing it directly.",
  "invoicePrefix": "EX-",
  "orgShortCode": "!xxxxx",
  "contact": {
    "name": "Example Client Name",
    "email": "client@example.com"
  },
  "invoiceSettings": {
    "type": "ACCREC",
    "lineAmountTypes": "Exclusive",
    "dueInDays": 14,
    "status": "DRAFT"
  },
  "lineItems": [
    {
      "description": "Example Service Description",
      "itemCode": "SERVICE-CODE",
      "accountCode": "200",
      "quantity": 1,
      "unitAmount": 100,
      "taxType": "OUTPUT"
    }
  ],
  "lineItemPatterns": [
    {
      "id": "consulting-session",
      "pattern": "consulting|consultation",
      "description": "Consulting Session",
      "itemCode": "CONSULT",
      "accountCode": "200",
      "taxType": "OUTPUT"
    },
    {
      "id": "development-work",
      "pattern": "development|dev work|coding",
      "description": "Development Work",
      "itemCode": "DEV",
      "accountCode": "200",
      "taxType": "OUTPUT"
    },
    {
      "id": "meeting",
      "pattern": "meeting|standup|sync",
      "description": "Meeting",
      "itemCode": "MEETING",
      "accountCode": "200",
      "taxType": "OUTPUT"
    },
    {
      "id": "special-project",
      "pattern": "special project|urgent",
      "description": "Special Project (Premium Rate)",
      "itemCode": "DEV",
      "accountCode": "200",
      "unitAmount": 200,
      "taxType": "OUTPUT"
    }
  ],
  "variables": {
    "quantity": {
      "description": "Number of units for the service",
      "default": 1
    },
    "invoiceNumber": {
      "description": "Invoice number (e.g., EX-1)",
      "required": true
    },
    "date": {
      "description": "Invoice date (YYYY-MM-DD or 'today')",
      "default": "today"
    }
  }
}
